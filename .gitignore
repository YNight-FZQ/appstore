# OSX
.DS_Store

# IntelliJ
.idea

# VSCode
.vscode

# LibreTV 安装时生成的密码和配置
apps/libretv/*/.env

# 本地生成的应用密钥文件
apps/ynight-hub/latest/conf/app.env

# Subconverter 安装时生成或自行维护的实际配置
apps/subconverter/latest/conf/pref.toml
apps/subconverter/latest/conf/auto_speed_test.ini
apps/subconverter/latest/groups.toml
apps/subconverter/latest/rulesets.toml

# Tavily Proxy Manager 的运行数据和安装参数
apps/tavily-proxy/latest/data/
apps/tavily-proxy/latest/.env

# 3X-UI installation parameters and generated credentials/data
apps/3xui/*/.env
apps/3xui/*/data/*
!apps/3xui/*/data/.gitkeep
apps/3xui/**/__pycache__/

# FreeLLMAPI encryption key, installation parameters and runtime data
apps/freellmapi/*/.env
apps/freellmapi/*/conf/app.env
apps/freellmapi/*/data/
