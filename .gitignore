# OSX
.DS_Store

# IntelliJ
.idea

# VSCode
.vscode

# LibreTV 安装时生成的密码和配置
apps/libretv/*/.env

# 本地生成的应用密钥文件
apps/ynight-hub/*/conf/app.env

# Subconverter 安装时生成或自行维护的实际配置
apps/subconverter/*/conf/pref.toml
apps/subconverter/*/conf/auto_speed_test.ini
apps/subconverter/*/groups.toml
apps/subconverter/*/rulesets.toml

# Tavily Proxy Manager 的运行数据和安装参数
apps/tavily-proxy/*/data/
apps/tavily-proxy/*/.env

# 3X-UI installation parameters and generated credentials/data
apps/3xui/*/.env
apps/3xui/*/data/*
!apps/3xui/*/data/.gitkeep
apps/3xui/**/__pycache__/

# FreeLLMAPI encryption key, installation parameters and runtime data
apps/freellmapi/*/.env
apps/freellmapi/*/conf/app.env
apps/freellmapi/*/data/

# What's Up Docker 安装参数与运行数据
apps/whats-up-docker/*/.env
apps/whats-up-docker/*/data/
