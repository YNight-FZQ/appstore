# 由安装脚本复制为 conf/app.env；请在实际配置文件中填写所需参数。
# MySQL 和 Redis 的主机、端口、库号及密码由 1Panel 安装表单提供，不要写在这里。

# Redis 缓存时长（秒）。
REDIS_TTL=86400

# Elasticsearch：地址需能从应用容器访问；启用认证时填写账号和密码。
ES_NODE=http://1Panel-elasticsearch-gLLf:9200
ES_USERNAME=elastic
ES_PASSWORD=
ES_LOG_INDEX_PREFIX=my-website-prod

# Cloudflare R2：将示例地址和空白凭据改成实际值。
R2_OSS_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_OSS_ACCESS_KEY_ID=
R2_OSS_ACCESS_KEY_SECRET=
R2_OSS_BUCKET=
R2_OSS_REGION=auto
R2_OSS_PUBLIC_BASE_URL=
DEFAULT_OSS_PROVIDER=r2

# 可选：Supabase 多账号配置，值为 JSON 数组；留空表示不启用。
SUPABASE_ACCOUNTS=
# 旧版单账号配置按需取消注释。
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_BUCKET=prize-images

# 可选：Bark 推送。BARK_SERVER 只填写域名，不带协议。
BARK_SERVER=
BARK_KEY=
SEND_BARK=false

# JWT_SECRET 在首次安装时自动生成；如自行填写，安装脚本会保留现有值。
JWT_SECRET=
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# 动漫与 aria2 功能的令牌需按实际服务填写。
SAFE_TOKEN=
TVBOX_API=
ARIA_TOKEN=
# aria2 容器中的绝对路径，应与其下载目录一致。
ARIA_DOWNLOAD_DIR=/var/aria2/sandbox
